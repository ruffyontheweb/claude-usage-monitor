{
  "title": "Claude Code usage: Fable vs Opus",
  "uid": "claude-usage",
  "tags": ["claude-code"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {"from": "now-7d", "to": "now"},
  "refresh": "1m",
  "templating": {
    "list": [
      {"name": "prom", "label": "Metrics", "type": "datasource", "query": "prometheus", "hide": 2},
      {"name": "tempo", "label": "Traces", "type": "datasource", "query": "tempo", "hide": 2}
    ]
  },
  "panels": [
    {"type": "row", "title": "Where is the Fable budget going? (selected time range)", "id": 1, "collapsed": false,
     "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "panels": []},
    {"type": "stat", "title": "Fable share of all tokens",
     "description": "Share of every token type (incl. cache reads) that went to Fable models.",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "100 * sum(increase({__name__=~\"claude_code[._]token[._]usage.*\", model=~\".*fable.*\"}[$__range])) / sum(increase({__name__=~\"claude_code[._]token[._]usage.*\"}[$__range]))",
       "legendFormat": "", "refId": "A", "instant": true, "range": false}],
     "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1,
       "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "textMode": "value"},
     "id": 2, "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4}},
    {"type": "stat", "title": "Fable share excl. cache reads",
     "description": "Same, ignoring cache reads. If this is much lower than the first number, Fable's usage is dominated by re-reading a long context.",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "100 * sum(increase({__name__=~\"claude_code[._]token[._]usage.*\", model=~\".*fable.*\", type!=\"cacheRead\"}[$__range])) / sum(increase({__name__=~\"claude_code[._]token[._]usage.*\", type!=\"cacheRead\"}[$__range]))",
       "legendFormat": "", "refId": "A", "instant": true, "range": false}],
     "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1,
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 40}, {"color": "red", "value": 60}]}}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "textMode": "value"},
     "id": 3, "gridPos": {"x": 6, "y": 1, "w": 6, "h": 4}},
    {"type": "stat", "title": "Fable: main session share",
     "description": "Of Fable tokens, the percent spent in the main session (vs subagents/auxiliary). High = orchestrator context is the cost.",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "100 * sum(increase({__name__=~\"claude_code[._]token[._]usage.*\", model=~\".*fable.*\", query_source=\"main\"}[$__range])) / sum(increase({__name__=~\"claude_code[._]token[._]usage.*\", model=~\".*fable.*\"}[$__range]))",
       "legendFormat": "", "refId": "A", "instant": true, "range": false}],
     "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1,
       "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "textMode": "value"},
     "id": 4, "gridPos": {"x": 12, "y": 1, "w": 6, "h": 4}},
    {"type": "stat", "title": "Fable: cache-read share",
     "description": "Of Fable tokens, the percent that are cache reads. High = long-running session re-reading history every turn.",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "100 * sum(increase({__name__=~\"claude_code[._]token[._]usage.*\", model=~\".*fable.*\", type=\"cacheRead\"}[$__range])) / sum(increase({__name__=~\"claude_code[._]token[._]usage.*\", model=~\".*fable.*\"}[$__range]))",
       "legendFormat": "", "refId": "A", "instant": true, "range": false}],
     "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1,
       "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "textMode": "value"},
     "id": 5, "gridPos": {"x": 18, "y": 1, "w": 6, "h": 4}},
    {"type": "row", "title": "Model x where it was dispatched", "id": 6, "collapsed": false,
     "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1}, "panels": []},
    {"type": "barchart", "title": "Tokens by model and source (main / subagent / auxiliary)",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "sum by (model, query_source) (increase({__name__=~\"claude_code[._]token[._]usage.*\"}[$__range]))",
       "legendFormat": "{{model}} | {{query_source}}", "refId": "A", "instant": true, "range": false, "format": "table"}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}}}],
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "options": {"orientation": "horizontal", "showValue": "auto", "stacking": "normal", "xField": "model",
       "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"}},
     "id": 7, "gridPos": {"x": 0, "y": 6, "w": 12, "h": 9}},
    {"type": "timeseries", "title": "Token rate by model (stacked)",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "sum by (model) (rate({__name__=~\"claude_code[._]token[._]usage.*\"}[$__rate_interval]))",
       "legendFormat": "{{model}}", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 30}}, "overrides": []},
     "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"}},
     "id": 8, "gridPos": {"x": 12, "y": 6, "w": 12, "h": 9}},
    {"type": "row", "title": "Fable deep dive", "id": 9, "collapsed": false,
     "gridPos": {"x": 0, "y": 15, "w": 24, "h": 1}, "panels": []},
    {"type": "timeseries", "title": "Fable tokens by type over time",
     "description": "input / output / cacheRead / cacheCreation. A climbing cacheRead band in the main session is the long-context signature.",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "sum by (type) (rate({__name__=~\"claude_code[._]token[._]usage.*\", model=~\".*fable.*\"}[$__rate_interval]))",
       "legendFormat": "{{type}}", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 30}}, "overrides": []},
     "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"}},
     "id": 10, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 9}},
    {"type": "table", "title": "Fable tokens by source x type",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "sum by (query_source, type) (increase({__name__=~\"claude_code[._]token[._]usage.*\", model=~\".*fable.*\"}[$__range]))",
       "legendFormat": "", "refId": "A", "instant": true, "range": false, "format": "table"}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}}},
       {"id": "groupingToMatrix", "options": {"columnField": "type", "rowField": "query_source", "valueField": "Value"}}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
     "id": 11, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 9}},
    {"type": "table", "title": "Tokens by agent name and model",
     "description": "Needs OTEL_LOG_TOOL_DETAILS=1, otherwise your own agents all show as 'custom'. Blank agent = main session.",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "sum by (agent_name, model) (increase({__name__=~\"claude_code[._]token[._]usage.*\"}[$__range]))",
       "legendFormat": "", "refId": "A", "instant": true, "range": false, "format": "table"}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}}},
       {"id": "sortBy", "options": {"sort": [{"field": "Value", "desc": true}]}}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
     "id": 12, "gridPos": {"x": 0, "y": 25, "w": 12, "h": 9}},
    {"type": "table", "title": "Top sessions by Fable tokens",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "topk(15, sum by (session_id) (increase({__name__=~\"claude_code[._]token[._]usage.*\", model=~\".*fable.*\"}[$__range])))",
       "legendFormat": "", "refId": "A", "instant": true, "range": false, "format": "table"}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}}},
       {"id": "sortBy", "options": {"sort": [{"field": "Value", "desc": true}]}}],
     "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
     "id": 13, "gridPos": {"x": 12, "y": 25, "w": 6, "h": 9}},
    {"type": "piechart", "title": "Fable tokens by effort",
     "datasource": {"type": "prometheus", "uid": "${prom}"},
     "targets": [{"datasource": {"type": "prometheus", "uid": "${prom}"},
       "expr": "sum by (effort) (increase({__name__=~\"claude_code[._]token[._]usage.*\", model=~\".*fable.*\"}[$__range]))",
       "legendFormat": "{{effort}}", "refId": "A", "instant": true, "range": false}],
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "legend": {"showLegend": true, "placement": "bottom", "displayMode": "list"}},
     "id": 14, "gridPos": {"x": 18, "y": 25, "w": 6, "h": 9}},
    {"type": "row", "title": "Dispatch traces (Tempo)", "id": 15, "collapsed": false,
     "gridPos": {"x": 0, "y": 34, "w": 24, "h": 1}, "panels": []},
    {"type": "table", "title": "Recent subagent model calls",
     "description": "Each row is a trace with a subagent llm_request. Click a trace ID to see the full tree: main turn -> Agent tool -> subagent calls.",
     "datasource": {"type": "tempo", "uid": "${tempo}"},
     "targets": [{"datasource": {"type": "tempo", "uid": "${tempo}"}, "refId": "A", "queryType": "traceql", "limit": 50,
       "tableType": "traces", "query": "{ name = \"claude_code.llm_request\" && span.agent_id != nil }"}],
     "id": 16, "timeFrom": "24h", "gridPos": {"x": 0, "y": 35, "w": 12, "h": 10}},
    {"type": "table", "title": "Recent Fable model calls",
     "datasource": {"type": "tempo", "uid": "${tempo}"},
     "targets": [{"datasource": {"type": "tempo", "uid": "${tempo}"}, "refId": "A", "queryType": "traceql", "limit": 50,
       "tableType": "traces", "query": "{ name = \"claude_code.llm_request\" && span.model =~ \".*fable.*\" }"}],
     "id": 17, "timeFrom": "24h", "gridPos": {"x": 12, "y": 35, "w": 12, "h": 10}},
    {"type": "timeseries", "title": "Main-session tokens from requests above the floor",
     "description": "Share of main-session cache-read tokens from requests whose context was at or above the handoff floor. Falling means handoffs keep conversations small. The floor is hard-coded at 200K here, matching floor_tokens in config/handoff.json: change both together. Capped at 24h because Tempo's TraceQL metrics refuse longer ranges. The ratio is a SQL expression, not math: Tempo range results carry an exemplar frame that math expressions reject; the SQL keeps only rows with __metric_name__ = sum_over_time.",
     "datasource": {"type": "tempo", "uid": "${tempo}"},
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
     "options": {"legend": {"showLegend": false, "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
     "targets": [
       {"datasource": {"type": "tempo", "uid": "${tempo}"}, "refId": "A", "queryType": "traceql", "metricsQueryType": "range", "step": "1h", "hide": true,
        "query": "{ name = \"claude_code.llm_request\" && span.query_source_safe = \"repl_main_thread\" && span.cache_read_tokens + span.input_tokens + span.cache_creation_tokens >= 200000 } | sum_over_time(span.cache_read_tokens)"},
       {"datasource": {"type": "tempo", "uid": "${tempo}"}, "refId": "B", "queryType": "traceql", "metricsQueryType": "range", "step": "1h", "hide": true,
        "query": "{ name = \"claude_code.llm_request\" && span.query_source_safe = \"repl_main_thread\" } | sum_over_time(span.cache_read_tokens)"},
       {"datasource": {"type": "__expr__", "uid": "__expr__"}, "refId": "C", "type": "sql",
        "expression": "SELECT b.time AS time, COALESCE(a.__value__, 0) / b.__value__ AS share FROM (SELECT time, __value__ FROM B WHERE __metric_name__ = 'sum_over_time') b LEFT JOIN (SELECT time, __value__ FROM A WHERE __metric_name__ = 'sum_over_time') a ON a.time = b.time WHERE b.__value__ > 0 ORDER BY b.time"}],
     "id": 18, "timeFrom": "24h", "gridPos": {"x": 0, "y": 45, "w": 24, "h": 8}}
  ]
}
